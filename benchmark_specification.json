  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Builds src/gups.c (OpenMP C, not C++) into bin/gups and issues random 64-bit table updates. table_size: table bytes. num_updates: updates per iteration. num_iterations: requested loops, capped to 2/8/24 for smoke/baseline/extended. num_threads, seed, and numa_node come from yaml. Optional perf stat records dTLB-load-misses, cache-misses, and instructions. thread_affinity and page_size yaml fields are not applied as huge-page setup"
  },
