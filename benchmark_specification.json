  {
    "field_name": "Validation Objective",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validates GUPS throughput and TLB/L3 miss rates from the C++ random-update benchmark"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Compile src/gups.c and run bin/gups with yaml table_size, num_updates, and seed, optionally wrapping with perf stat -e dTLB-load-misses,cache-misses,instructions, then derive GB/s as 8-byte updates/s, to measure random 64-bit update rate. Profile caps iterations at 2 / 8 / 24 regardless of a larger yaml request"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Compile src/gups.c, run bin/gups with yaml table_size, num_updates, and seed, and optionally wrap it with perf stat for dTLB-load-misses, cache-misses, and instructions. Derive GB/s as 8-byte updates per second. The profile caps iterations at 2, 8, or 24"
  },
